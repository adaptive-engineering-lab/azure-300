# Copy to .env.local. Only public (anon) keys belong here.
# The service_role key is for the seed tooling only (tools/.env.local), NEVER the frontend.

# New AI-300 Supabase project — get these from your AI-300 Supabase dashboard
VITE_SUPABASE_URL=https://<ai300-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Exam identity — used in page titles, meta tags, og:title
VITE_EXAM_CODE=AI-300
VITE_EXAM_TITLE=Operationalize ML and Generative AI Solutions
VITE_CERT_TITLE=ML Operations Engineer Associate

# Product-ID mode off for AI-300
VITE_ENABLE_PRODUCT_ID=false
