# Copy to .env.local and fill in values from `supabase start` (local) or the Supabase dashboard (remote).
# .env.local is gitignored; .env.example is committed.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to 1 to run the seed in dry-run mode (no DB writes)
# DRY_RUN=0
